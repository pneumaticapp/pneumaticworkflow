msgid "FILE_SERVICE_URL not configured."
msgstr "لم يتم إعداد FILE_SERVICE_URL."

msgid "Connection to file service failed."
msgstr "فشل الاتصال بخدمة الملفات."

msgid "User required for authentication."
msgstr "المستخدم مطلوب للمصادقة."

msgid "Authentication failed with file service."
msgstr "فشلت المصادقة مع خدمة الملفات."

msgid "File size exceeds maximum allowed size."
msgstr "يتجاوز حجم الملف الحد الأقصى المسموح."

msgid "File type not supported."
msgstr "نوع الملف غير مدعوم."

msgid "File service request failed."
msgstr "فشل طلب خدمة الملفات."

msgid "File service returned invalid response."
msgstr "أعادت خدمة الملفات استجابة غير صالحة."

msgid "Failed to parse file service response."
msgstr "تعذر تحليل استجابة خدمة الملفات."

msgid "File service did not return file_id."
msgstr "لم تُعد خدمة الملفات معرّف file_id."

msgid "file_id cannot be empty."
msgstr "لا يمكن أن يكون file_id فارغًا."

