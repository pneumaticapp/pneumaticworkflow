# Settings of the audit journal storage machine.
#   cp elasticsearch.env.example .env
# and fill in every REQUIRED line. The file is read by docker compose and by
# every script in ./scripts. Keep it 600 and out of git (.gitignore covers it).

# =============================================================================
# Passwords and keys - REQUIRED, no defaults
# =============================================================================
# Superuser of the cluster. Used by the scripts and for emergencies; day to day
# work goes through the reader account below.
#   openssl rand -base64 24
ES_ELASTIC_PASSWORD=

# Password of the built-in kibana_system account. Kibana logs in with it; a
# person never types it.
KIBANA_SYSTEM_PASSWORD=

# 32+ characters. Kibana encrypts saved objects with it. Changing it later
# makes existing alert rules and connectors unreadable.
#   openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=

# Read only account for people who look at the journal in Kibana. Created by
# bootstrap.sh; leave the password empty to skip creating it.
ES_READER_USER=pneumatic-reader
ES_READER_PASSWORD=

# =============================================================================
# Certificates
# =============================================================================
# Host names and addresses the certificate is issued for. The address in
# LOGS_ELASTICSEARCH_URL on the application machine MUST be in this list,
# otherwise the collector refuses the connection ("certificate is valid for
# ..., not ...").
ES_CERT_DNS=es.pneumatic.internal
ES_CERT_IP=
KIBANA_CERT_DNS=kibana.pneumatic.internal
KIBANA_CERT_IP=

# Lifetime in days. The node certificate is renewed by hand, so a long enough
# period matters: 730 days means twice per four years, with a calendar
# reminder 30 days ahead.
ES_CA_DAYS=3650
ES_CERT_DAYS=730

# =============================================================================
# Node
# =============================================================================
ES_NODE_NAME=pneumatic-es-01
ES_CLUSTER_NAME=pneumatic-audit

# Container memory limit and JVM heap. Rule: heap = half of the limit, never
# above 31g. The other half is the file cache Lucene searches through.
ES_MEM_LIMIT=4g
ES_HEAP_SIZE=2g
KIBANA_MEM_LIMIT=1500m

# Keeps the heap out of swap. Set to false only if the kernel refuses to lock
# memory and the node will not start (the log says "Unable to lock JVM
# Memory") - and then turn swap off instead.
ES_MEMORY_LOCK=true

# Published ports. 9200 is open to the network on purpose: the collector
# connects from the application machine over TLS. Restrict it with a firewall
# rule to that machine. Kibana stays local; reach it over an SSH tunnel or put
# a reverse proxy in front of it.
ES_BIND=0.0.0.0
ES_PORT=9200
KIBANA_BIND=127.0.0.1
KIBANA_PORT=5601
KIBANA_PUBLIC_URL=https://localhost:5601

# =============================================================================
# Index, lifecycle, snapshots
# =============================================================================
# Data stream the collector writes into. The name is what the exporter builds
# out of `logs-<dataset>.otel-<namespace>`, see
# logging/otel/backend-elasticsearch.yaml.
ES_DATA_STREAM=logs-pneumatic.events.otel-default
ES_INDEX_PATTERN=logs-pneumatic.events.otel-*

# logsdb = the storage mode built for logs: fields sorted, no _source stored
# where it can be rebuilt from doc values. Measured on Pneumatic events it
# saves about a third of the disk. `standard` is the classic mode.
ES_INDEX_MODE=logsdb

# One shard per node, one replica. A replica is the only thing that keeps the
# journal readable when a disk dies, and it doubles the disk. On a single node
# cluster it can never be allocated: set ES_INDEX_REPLICAS=0 there, or accept a
# yellow cluster forever.
ES_INDEX_SHARDS=1
ES_INDEX_REPLICAS=1

# Retention (SOC LOG-03 asks for at least twelve months) and rollover.
# Real retention = ES_RETENTION plus at most ES_ROLLOVER_AGE, because the age
# is counted from the moment the index stopped being written to.
ES_RETENTION=365d
ES_ROLLOVER_AGE=30d
ES_ROLLOVER_SIZE=50gb

# Snapshots: schedule (cron, seconds first) and how long they are kept.
ES_SNAPSHOT_SCHEDULE="0 30 1 * * ?"
ES_SNAPSHOT_RETENTION=90d

# =============================================================================
# Optional
# =============================================================================
# A second compose file for site specific changes: another volume for
# /snapshots (a separate disk, an NFS export), another port, a second node.
# The scripts read it too, so `docker compose` and ./scripts see the same
# stack. Example:
#   ES_COMPOSE_OVERRIDE=/etc/pneumatic-es/snapshots-on-nfs.yml
ES_COMPOSE_OVERRIDE=

# Image the scripts use for throwaway containers (issuing certificates,
# handing the snapshot directory over to uid 1000). Keep it equal to the image
# in docker-compose.yml when you change the version.
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.5.3

# Lifetime of the collector API key. Rotate it with
# ./scripts/rotate-api-key.sh before it expires.
ES_API_KEY_EXPIRATION=90d
