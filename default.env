# Pneumatic Workflow Configuration

# This is a configuration file listing all parameters and their default values.
# After changing the parameters, you need to restart the Docker containers.


# =============================================================================
# Server address
# =============================================================================
# SERVER_ADDRESS=localhost
# BACKEND_URL=http://localhost:8001
# FRONTEND_URL=http://localhost
# FORMS_URL=http://localhost/forms
# WSS_URL=ws://localhost:8001

# Custom form domain works only with SSL=yes
# If FORM_DOMAIN is specified, use NGINX_CONF_TEMPLATE=./nginx/ssl_forms_templates/
# FORM_DOMAIN=

# =============================================================================
# Nginx / SSL
# =============================================================================
# SSL=no
# NGINX_CONF_TEMPLATE=./nginx/ssl_templates/

# --- Certbot ---
# CERTBOT_ENABLE=no
# CERTBOT_EMAIL=

# =============================================================================
# Database
# =============================================================================

# --- PostgreSQL ---
# POSTGRES_PASSWORD=postgres_password
# POSTGRES_REPLICA_PASSWORD=postgres_password
# POSTGRES_HOST=postgres
# POSTGRES_USER=postgres_user
# POSTGRES_DB=postgres_db
# POSTGRES_REPLICA_HOST=postgres
# POSTGRES_REPLICA_USER=postgres_user
# POSTGRES_REPLICA_DB=postgres_db

# --- Redis ---
# Cache (db0), auth tokens (db1), websocket channels (db2), sessions (db3) and
# the event buffer (db4, see Logging / Events below).
# REDIS_PASSWORD=redis_password

# --- RabbitMQ ---
# RABBITMQ_USER=rabbitmq_user
# RABBITMQ_PASSWORD=rabbitmq_password

# =============================================================================
# Application
# =============================================================================

# ENVIRONMENT=Production
# LANGUAGE_CODE=en

# --- Backend ---
# WORKERS_COUNT=2
# DJANGO_DEBUG=no
# ADMIN_PATH=admin
# DJANGO_SECRET_KEY=django_secret_django_secret_django_secret
# ENABLE_LOGGING=no
# SENTRY_DSN=

# --- Frontend ---
# NODE_OPTIONS=--max-old-space-size=3072
# SENTRY_FRONTEND_DSN=
# MCS_RUN_ENV=prod

