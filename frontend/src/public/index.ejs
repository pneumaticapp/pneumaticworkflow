<!DOCTYPE html>
<html lang="<%= typeof documentLocale !== 'undefined' ? documentLocale.lang : 'en-US' %>" dir="<%= typeof documentLocale !== 'undefined' ? documentLocale.dir : 'ltr' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0" />

    <title><%= typeof brandName !== 'undefined' ? brandName : 'Masarat' %></title>
  </head>
  <body>
    <div id="pneumatic-frontend"></div>
    <script type="text/javascript">
      window.__pneumaticConfig = {
        config: <%- config %>,
        env: "<%= env %>",
        user:  <%- user %>,
        invitedUser:  <%- invitedUser %>,
        pages: <%- pages %>
      };
    </script>
  </body>
</html>
