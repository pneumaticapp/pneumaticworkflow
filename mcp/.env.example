# Pneumatic backend API (cloud: https://api.pneumatic.app, self-hosted: http://your-address:8001)
PNEUMATIC_API_URL=https://api.pneumatic.app
# Public file storage URL (backend FILE_SERVICE_URL); defaults to https://my.pneumatic.app/files for the cloud API
# PNEUMATIC_FILES_URL=https://pneumatic.example.com/files
# Address the connector uses for storage requests when PNEUMATIC_FILES_URL is unreachable from it (e.g. a container)
# PNEUMATIC_FILES_INTERNAL_URL=http://pneumatic-file-service:8000
# Web app URL for links in results; defaults to PNEUMATIC_FILES_URL without /files
# PNEUMATIC_APP_URL=https://pneumatic.example.com

# stdio mode (Claude Desktop / Claude Code local server)
PNEUMATIC_API_KEY=

# http mode (Claude.ai custom connector)
MCP_TRANSPORT=http
HOST=0.0.0.0
PORT=3000
# Public HTTPS origin Claude reaches the connector at; the MCP endpoint is $PUBLIC_URL/mcp
PUBLIC_URL=https://mcp.example.com
# Encrypts OAuth tokens; changing it signs everyone out. Generate with: openssl rand -hex 32
TOKEN_SECRET=
# Existing persistent, writable replay ledger (create empty file once; mount /state in Docker)
OAUTH_REPLAY_FILE=/state/replay.json
# Comma-separated OAuth redirect hosts; "*" allows any
OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
# MCP requests per minute per API key; 0 disables the limit
RATE_LIMIT_PER_MINUTE=120
# Which reverse proxy may set X-Forwarded-For (Express trust proxy). The default trusts loopback and private
# networks (Docker bridge); set the proxy's exact address or subnet when the connector is reachable from a private LAN
TRUST_PROXY=loopback,uniquelocal
# Tool groups to offer (core, files, design, analytics, admin) or all; READ_ONLY=true hides every write tool
# TOOLSETS=core,files
# READ_ONLY=false
# Logging (JSON on stderr) and Prometheus metrics at /metrics for "Authorization: Bearer <METRICS_TOKEN>"
# LOG_LEVEL=info
# METRICS_TOKEN=
